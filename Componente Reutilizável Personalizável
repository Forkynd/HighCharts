import Highcharts from "highcharts";
import { useMemo } from "react";
import HighchartsReact from "highcharts-react-official";

export default function ChartsBaseColunaEmpilhada(props: any) {
  const coresPadrao = [
    "#3c0075",
    "#7e00eb",
    "#5a00b2",
    "#a02cff",
    "#c57dff",
    "#e0a9ff",
    "#e6c5ff",
    "#c8b6ff",
    "#b8c0ff",
    "#bbd0ff",
    "#c3f4ff",
    "#a2efff",
    "#80eaff",
    "#2ddbff",
    "#00b3d8",
    "#0095c7",
    "#0076b6",
    "#003d8b",
    "#000161",
    "#000814",
  ];

  //Função para deixar cor opcional
  const coresAtivas: string[] =
    Array.isArray(props.cores) && props.cores.length > 0
      ? props.cores
      : coresPadrao;

  // conversor apenas interno (continua recebendo tudo como string)
  const toNumberSafe = (val: string): number => {
    if (val == null) return 0;
    let s = String(val).trim();
    if (s === "" || s.toLowerCase() === "null" || s.toLowerCase() === "nan")
      return 0;
    // formato pt-BR: 1.234,56
    if (/^\d{1,3}(\.\d{3})*(,\d+)?$/.test(s)) {
      s = s.replace(/\./g, "").replace(",", ".");
    }
    const n = Number(s);
    return Number.isFinite(n) ? n : 0;
  };

  //normaliza os dados (todos strings)
  const dados = useMemo(
    () =>
      (props.dadosGraficoFormatos || []).map((d: any) => ({
        EIXO_X: (d.EIXO_X ?? "").toString().trim(),
        SUB_NOME_COLUNA: (d.SUB_NOME_COLUNA ?? "").toString().trim(),
        QTD_ITENS_STR: (d.QTD_ITENS ?? "").toString(),
        TITULO_MEDICAO: (d.TITULO_MEDICAO ?? "").toString(),
        TITULO_TOOLTIP_MEDICAO: (d.TITULO_TOOLTIP_MEDICAO ?? "").toString(),
        TITULO_LADO_Y: (d.TITULO_LADO_Y ?? "").toString(),
        TIPO_SERIE: (d.TIPO_SERIE ?? "").toString(),
      })),
    [props.dadosGraficoFormatos],
  );

  const percentualBaseSerie = props.tooltipPercentualBase;

  const categorias = useMemo(
    () => [...new Set(dados.map((d: any) => d.EIXO_X))],
    [dados],
  );

  const familias = useMemo(
    () => [...new Set(dados.map((d: any) => d.SUB_NOME_COLUNA))],
    [dados],
  );

  // recarregadr series

  const series = useMemo(
    () =>
      familias.map((fam: string, i: number) => {
        // Descobre se algum dado dessa família pediu um tipo específico
        const tipoSerieCustom = dados.find(
          (d: any) => d.SUB_NOME_COLUNA === fam && d.TIPO_SERIE,
        )?.TIPO_SERIE;

        // Se tiver TIPO_SERIE válido, usa. Senão, usa o tipo padrão (column/bar).
        const tipoSerie =
          tipoSerieCustom === "line" ||
          tipoSerieCustom === "spline" ||
          tipoSerieCustom === "column" ||
          tipoSerieCustom === "bar"
            ? (tipoSerieCustom as any)
            : ((props.tipoDoGrafico as "column" | "bar") ?? "column");

        const isSpline = tipoSerie === "spline" || tipoSerie === "line";

        return {
          name: fam,
          data: categorias.map((cat: string) =>
            dados
              .filter((d: any) => d.EIXO_X === cat && d.SUB_NOME_COLUNA === fam)
              .reduce(
                (sum: number, d: any) => sum + toNumberSafe(d.QTD_ITENS_STR),
                0,
              ),
          ),
          color: coresAtivas[i % coresAtivas.length],
          type: tipoSerie,

          yAxis: isSpline ? 1 : 0, // spline no eixo secundário
          zIndex: isSpline ? 5 : 1, // spline desenhada por cima
          marker: isSpline
            ? {
                enabled: true,
                radius: 3,
                lineWidth: 1,
              }
            : undefined,
        };
      }),
    [familias, categorias, dados, props.tipoDoGrafico],
  );

  const TITULO_MEDICAO = dados[0]?.TITULO_MEDICAO ?? "";
  const TITULO_TOOLTIP_MEDICAO = dados[0]?.TITULO_TOOLTIP_MEDICAO
    ? dados[0].TITULO_TOOLTIP_MEDICAO
    : "";
  const TITULO_LADO_Y = dados[0]?.TITULO_LADO_Y ?? "";

  const options: Highcharts.Options = useMemo(
    () => ({
      chart: {
        type: (props.tipoDoGrafico as "column" | "bar") || "column",
        height: props.tamanhoGraficoHeight ?? 400,
        width: props.tamanhoGraficoWidth ?? 1000,
        backgroundColor: "white",
        style: { fontFamily: "Helvetica, Arial, sans-serif !important" },
      },
      title: { text: props.TituloPrincipal || undefined },
      subtitle: { text: undefined },
      credits: { enabled: false },

      tooltip: {
        shared: true,
        padding: 2,
        useHTML: true,
        hideDelay: 250,
        backgroundColor: "#10002B",
        borderRadius: 0,
        borderColor: "rgba(128, 128, 128, 0.324)",
        distance: 40,
        outside: false,
        shadow: {
          color: "rgb(54, 22, 106)",
          width: 10,
          opacity: 1,
          offsetX: 0,
          offsetY: 0,
        },
        style: {
          color: "rgb(160, 111, 239)",
          fontSize: props.fontSizeTooltip ?? "10px",
        },
        formatter: function () {
          const pts = (this.points || []) as Highcharts.Point[];

          const basePoint = percentualBaseSerie
            ? pts.find((p) => p.series.name === percentualBaseSerie)
            : null;

          const baseValor =
            basePoint && typeof basePoint.y === "number" ? basePoint.y : null;

          const total = pts.reduce((acc, p) => acc + Number(p.y || 0), 0);

          // Para eixo category + shared:true, use key/category do primeiro ponto
          const categoria =
            (pts[0] &&
              ((pts[0] as any).key ?? (pts[0] as any).point?.category)) ??
            String(this.x ?? "");

          const linhasTooltip = pts
            .map((p) => {
              // Cuidado: percentage só existe com stacking: 'percent'

              const perc =
                baseValor !== null && baseValor > 0
                  ? p.series.name === percentualBaseSerie
                    ? "100.00"
                    : ((Number(p.y || 0) / baseValor) * 100).toFixed(2)
                  : total > 0
                    ? ((Number(p.y || 0) / total) * 100).toFixed(2)
                    : "0.00";

              return `
              <tr class="tooltipLinha" style="background-color:${
                p.series.color
              }">
                <td><b>${p.series.name}</b></td>
                <td class="tooltipColunaTipo"><b>${p.y ?? 0}</b> (${perc}%)</td>
              </tr>
            `;
            })
            .join("");

          const temTituloMedicao =
            TITULO_MEDICAO &&
            TITULO_MEDICAO.trim() !== "" &&
            TITULO_MEDICAO.toLowerCase() !== "null";

          const linhaTotal = temTituloMedicao
            ? `
    <tr class="tooltipColunaTipo">
      <td>${TITULO_MEDICAO}</td>
      <td>${total}</td>
    </tr>
  `
            : "";

          const cabecalho = `
  <div class="tooltipConteiner">
    <table class="tooltipTable">
      <thead class="tooltipTopo">
        <tr class="tooltipMes">
          <th colspan="2">
            ${props.tituloPrincipalTooltip || ""}  ${categoria}
          </th>
        </tr>
        ${linhaTotal}
      </thead>
      <tbody class="tooltipCorpo">
`;

          return cabecalho + linhasTooltip + `</tbody></table></div>`;
        },
        positioner: function (labelWidth, _labelHeight, point) {
          const plotX = (point as any).plotX || 0;
          const chartWidth = this.chart.chartWidth;
          return {
            x:
              plotX + labelWidth + 90 > chartWidth
                ? plotX - labelWidth
                : plotX + 100,
            y: 40,
          };
        },
      },

      legend: {
        enabled: false,
        layout: "horizontal",
        align: "center",
        x: 0,
        verticalAlign: "top",
        y: 0,
        floating: false,
      },

      xAxis: {
        type: "category",
        title: { text: undefined },
        lineWidth: 3,
        lineColor: "rgb(54, 22, 106)",
        tickInterval: 1,
        categories: categorias,
        crosshair: true,
        labels: { rotation: -45, style: { fontSize: "12px" } },
      },

      yAxis: [
        {
          // EIXO PRIMÁRIO – para as colunas empilhadas
          title: { text: TITULO_LADO_Y },
          stackLabels: {
            enabled: props.mostrarTotalStack === true,
            style: { fontWeight: "bold" },
          },
          lineWidth: 3,
          lineColor: "rgb(54, 22, 106)",
          gridLineWidth: 1,
          gridLineColor: "rgb(182, 147, 237)",
          gridLineDashStyle: "solid",
          min: 0,
          reversedStacks: props.reversedStacks ?? true,
        },
        {
          title: { text: TITULO_LADO_Y || "" },
          opposite: true,
          gridLineWidth: 0,
          min: 0,
          max: typeof props.maxEixoY === "number" ? props.maxEixoY : undefined,
        },
      ],

      plotOptions: {
        series: { states: { hover: { halo: false } } },

        column: {
          shadow: {
            color: "rgb(54, 22, 106)",
            width: 5,
            opacity: 1,
            offsetX: 0,
            offsetY: 0,
          },
          dataLabels: {
            enabled: props.TotalMeioColuna ?? true,
            format: "{point.y}",
            style: { fontSize: "10px" },
          },
          stacking: "normal",
          enableMouseTracking: true,
        },
        bar: {
          shadow: {
            color: "rgb(54, 22, 106)",
            width: 5,
            opacity: 1,
            offsetX: 0,
            offsetY: 0,
          },

          dataLabels: {
            enabled: props.TotalMeioColuna ?? true,
            style: { fontSize: "10px" },
            formatter: function () {
              // this.y = valor do segmento da barra
              return this.y && this.y !== 0 ? this.y : null;
            },
          },

          stacking: "normal",
          enableMouseTracking: true,
        },
        line: {
          shadow: {
            color: "rgb(54, 22, 106)",
            width: 5,
            opacity: 1,
            offsetX: 0,
            offsetY: 0,
          },
          dataLabels: {
            enabled: true,
            format: "{point.y}",
            style: { fontSize: "10px" },
          },
          stacking: "normal",
          enableMouseTracking: true,
        },
        line: {
          shadow: {
            color: "rgb(54, 22, 106)",
            width: 5,
            opacity: 1,
            offsetX: 0,
            offsetY: 0,
          },
          dataLabels: {
            enabled: true,
            format: "{point.y}",
            style: { fontSize: "10px" },
          },

          stacking: undefined,
          enableMouseTracking: true,
        },
      },

      series: series,
    }),
    [props.dadosGraficoFormatos],
  );

  return (
    <div className="SubPáginaGraficoConteinerTopo">
      <HighchartsReact
        highcharts={Highcharts}
        options={options}
        oneToOne={true}
        allowChartUpdate={true}
        immutable={false}
      />
    </div>
  );
}

