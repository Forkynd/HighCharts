// Importa a biblioteca principal do Highcharts.
import Highcharts from "highcharts";
// Ele integra o Highcharts com o ciclo de vida do React
import HighchartsReact from "highcharts-react-official";
// Hook:evita recalcular dados e opções do gráfico desnecessariamente.
import { useMemo } from "react";
import { Box } from "@mui/material";

interface EstiloSerie {
  corLinha?: string; // line / area
  corArea?: string; // area
  larguraLinha?: number;
  opacidadeArea?: number;
}

interface GraficoColunasProps<T> {
  dados: T[]; // Lista de dados que será usada para montar o gráfico
  obterChave: (item: T) => number | string | null | undefined; // Função responsável por extrair a "chave" de agrupamento.
  /*
   * Função que recebe a chave e devolve:
   * - o título 
   * - a cor da coluna
   */
  obterConfiguracao: (chave: number | string) => {
    titulo: string;
    backgroundColor?: string; //cor da coluna
    estilo?: EstiloSerie;
  };
tooltip?: Highcharts.TooltipOptions;
  titulo: string; // Título exibido no topo do gráfico
  tipoGrafico?: "column" | "bar" | "line" | "area"; //Tipo do gráfico (opcional)
}

/*
 * Componente de gráfico genérico e reutilizável.
 * Ele NÃO sabe o que são os dados, apenas como processá-los.
 */
export function GraficoColunas<T>({
  dados,
  obterChave,
  obterConfiguracao,
  titulo,
  tooltip,
  tipoGrafico = "column", // valor padrão caso o usuário não informe
}: GraficoColunasProps<T>) {
  // Processa os dados recebidos e transforma no formato que o Highcharts entende.
  const dadosGrafico = useMemo(() => {
    // Objeto usado para contar quantas vezes cada chave aparece
    // Ex: { "0": 5, "1": 3 }
    const contador: Record<string, number> = {};

    // Percorre todos os itens da lista de dados
    for (const item of dados) {
      // Extrai a chave de agrupamento usando a função recebida
      const chave = obterChave(item);

      // Garante que a chave não seja null ou undefined
      if (chave != null) {
        // Converte a chave para string (objetos JS usam string como chave)
        const key = String(chave);

        // Incrementa o contador:
        // - se já existir, soma 1
        // - se não existir, começa em 0 e soma 1
        contador[key] = (contador[key] ?? 0) + 1;
      }
    }

    // Converte o objeto contador em um array de dados para o Highcharts

    return Object.entries(contador).map(([chave, quantidade]) => {
      const { titulo, backgroundColor, estilo } = obterConfiguracao(chave);

      return {
        name: titulo,
        y: quantidade,

        // Column / bar
        color: backgroundColor,

        // Line / area
        lineWidth: estilo?.larguraLinha,
        ...(estilo?.corLinha && { color: estilo.corLinha }),

        // Area
        ...(estilo?.corArea && {
          fillColor: Highcharts.color(estilo.corArea)
            ?.setOpacity(estilo.opacidadeArea ?? 0.4)
            .get(),
        }),
      };
    });
  }, [dados, obterChave, obterConfiguracao]);

  // Configuração completa do gráfico Highcharts.
  const options: Highcharts.Options = useMemo(
    () => ({
      chart: {
        // Tipo do gráfico (column, bar, line, area)
        type: tipoGrafico,
        // Cor de fundo do gráfico
        backgroundColor: "#fcf9ff",
      },

      // Configuração do título do gráfico
      title: {
        text: titulo,
        style: {
          fontWeight: "bold",
          fontSize: "20px",
        },
      },

      // Configuração do eixo X
      xAxis: {
        // Usa os nomes das categorias (name)
        type: "category",
        labels: {
          style: {
            fontWeight: "bold",
          },
        },
      },

      // Configuração do eixo Y
      yAxis: {
        // Remove o título do eixo Y para um visual mais limpo
        title: { text: "" },
      },

      // Tooltip exibido ao passar o mouse sobre a coluna
      tooltip: tooltip ?? {
        pointFormat: "Quantidade: <b>{point.y}</b>",
      },

      // Opções específicas para gráficos de coluna

      plotOptions: {
        column: {
          borderRadius: 6,
          dataLabels: { enabled: true },
        },
        area: {
          dataLabels: { enabled: true },
        },
        line: {
          dataLabels: { enabled: true },
        },
      },

      credits: { enabled: false },
      legend: { enabled: false },

      series: [
        {
          type: tipoGrafico,
          data: dadosGrafico,
        } as Highcharts.SeriesOptionsType,
      ],
    }),
    [dadosGrafico, titulo, tipoGrafico],
    // Dependências do useMemo
  );

  // Renderização do gráfico
  return (
    <Box sx={{ mt: 4 }}>
      {/* Componente que renderiza o Highcharts dentro do React */}
      <HighchartsReact highcharts={Highcharts} options={options} />
    </Box>
  );
}
